PORT=3000
DATABASE_URL=postgresql://usuario:senha@host:5432/postgres
JWT_SECRET=troque-este-segredo
NODE_ENV=development

# URL publica usada para montar links de fotos quando o upload cair no storage local.
# Em desenvolvimento no celular, use o IP da maquina na rede.
PUBLIC_API_URL=http://192.168.3.213:3000

# Opcional: ativa upload em nuvem via Supabase Storage.
# Sem essas variaveis, o backend salva as fotos em backend/uploads e serve em /uploads.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=doebem

# Use false para gravar notificacoes no banco sem chamar o servico Expo Push.
SEND_PUSH_NOTIFICATIONS=true
